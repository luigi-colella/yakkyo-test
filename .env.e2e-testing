# End-to-end tests only (`yarn test:e2e`, docker-compose.e2e.yml): used instead of .env.
# Committed on purpose: it holds no secrets and OpenAI is always mocked. Never put a real key here.

# Service URLs (Docker Compose network names)
MONGO_URI=mongodb://mongo:27017/crawler
RABBIT_URL=amqp://rabbit:5672

# API
PORT=8080
# Effectively unlimited: the tests must not depend on how many requests they send.
# The rate limit has its own tests (api/test/app.test.ts).
RATE_LIMIT_PER_MINUTE=100

# OpenAI: always the deterministic mock description.
OPENAI_MOCK=1
OPENAI_API_KEY=

# The fixture site lives on the private Docker network: only its two host names are
# exempted from the worker's SSRF address check.
E2E_MODE=1
E2E_ALLOWED_HOSTS=fixture-site,fixture-robots-denied
