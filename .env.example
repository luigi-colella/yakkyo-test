# Copy to .env and adjust. docker-compose reads this file.

# Service URLs (Docker Compose network names)
MONGO_URI=mongodb://mongo:27017/crawler
RABBIT_URL=amqp://rabbit:5672

# API
PORT=8080
# Optional: pino log level (default info) and POST /crawl requests per IP per minute (default 10).
# LOG_LEVEL=info
# RATE_LIMIT_PER_MINUTE=10

# OpenAI: with OPENAI_MOCK=1 the worker returns a deterministic description and needs no key.
OPENAI_MOCK=1
OPENAI_API_KEY=
