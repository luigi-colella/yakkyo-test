# Copy to .env and adjust. docker-compose reads this file.

# Service URLs (Docker Compose network names)
MONGO_URI=mongodb://mongo:27017/crawler
RABBIT_URL=amqp://rabbit:5672

# API
PORT=8080
# Optional: POST /crawl requests per IP per minute (default 10).
# RATE_LIMIT_PER_MINUTE=10

# Optional, API and worker: pino log level (default info).
# LOG_LEVEL=info

# OpenAI: with OPENAI_MOCK=1 the worker returns a deterministic description and needs no key.
OPENAI_MOCK=1
OPENAI_API_KEY=
# Optional: vision-capable model used by the worker (default gpt-5-mini).
# OPENAI_MODEL=gpt-5-mini

# End-to-end tests only: E2E_MODE=1 lets the listed fixture hosts resolve to private
# addresses on the Docker network. E2E_ALLOWED_HOSTS is refused without E2E_MODE=1.
# E2E_MODE=0
# E2E_ALLOWED_HOSTS=
