{
  "name": "mini-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "shared",
    "api",
    "worker",
    "web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "setup:browser": "yarn workspace @crawler/worker playwright install chromium",
    "test": "vitest run --passWithNoTests",
    "typecheck": "yarn workspaces foreach --all --parallel --topological run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.48"
    }
  }
}
